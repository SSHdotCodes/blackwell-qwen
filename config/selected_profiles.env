# Conservative defaults. Replaced by the measured Hugging Face Job result.
LATENCY_CANDIDATE=flashinfer_auto_c2k
LATENCY_FLAGS="--attention-backend flashinfer --fp8-gemm-backend auto --chunked-prefill-size 2048 --max-prefill-tokens 2048 --cuda-graph-max-bs 32 --mamba-full-memory-ratio 1.8 --max-running-requests 32"
THROUGHPUT_CANDIDATE=flashinfer_cutlass_mtp_c2k
THROUGHPUT_FLAGS="--attention-backend flashinfer --fp8-gemm-backend cutlass --chunked-prefill-size 2048 --max-prefill-tokens 2048 --cuda-graph-max-bs 32 --mamba-full-memory-ratio 1.8 --max-running-requests 32 --speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4"
